# ============================================================================
#  LILITH-CORE — секреты и локальные переопределения
#  Скопируйте этот файл в `.env` и заполните своими значениями.
#  .env в git НЕ коммитим (он уже в .gitignore).
#
#  Правила именования:  LILITH_<РАЗДЕЛ>__<ПОЛЕ>   (двойное подчёркивание = вложенность)
# ============================================================================

# --- Путь к конфигу (необязательно) ---
# LILITH_CONFIG=D:\Projects\lilith\config\config.yaml

# --- ЭТАП 2: мозг -----------------------------------------------------------
# Ключ для OpenAI-совместимого endpoint. Для локального LM Studio/llama.cpp
# подойдёт любое непустое значение, например "lm-studio".
LILITH_BRAIN__API_KEY=
# Профиль по умолчанию (chat / coder / vision / summarizer / experiment / свой):
# LILITH_BRAIN__DEFAULT_PROFILE=chat
#
# Реестр профилей: каждая модель = именованный профиль. Переопределить или
# добавить экспериментальную модель можно и без правки config.yaml:
# LILITH_BRAIN__PROFILES__CHAT__MODEL=qwen3.5-9b-instruct-q4_k_m
# LILITH_BRAIN__PROFILES__CHAT__BASE_URL=http://127.0.0.1:1234/v1
# LILITH_BRAIN__PROFILES__EXPERIMENT__MODEL=qwen4-2b-whatever-Q4_K_M
# LILITH_BRAIN__PROFILES__EXPERIMENT__BASE_URL=http://127.0.0.1:1237/v1

# --- ЭТАП 5: VTuber Studio ---------------------------------------------------
# LILITH_VTS_TOKEN=

# --- ЭТАП 6: OBS -------------------------------------------------------------
# LILITH_OBS_PASSWORD=

# --- ЭТАП 7: мосты -----------------------------------------------------------
# LILITH_DISCORD_TOKEN=
# LILITH_VK_TOKEN=

# --- ЭТАП 8: Twitch ----------------------------------------------------------
# LILITH_TWITCH_TOKEN=

# --- Локальные переопределения сервера (примеры) -----------------------------
# LILITH_SERVER__HOST=127.0.0.1
# LILITH_SERVER__PORT=8765
# LILITH_LOGGING__LEVEL=DEBUG
# LILITH_APP__USER_NAME=Кирюша
