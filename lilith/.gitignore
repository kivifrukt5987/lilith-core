# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# --- Виртуальное окружение ---
.venv/
venv/
env/

# --- Секреты ---
.env
config/config.local.yaml

# --- Данные и логи (создаются в рантайме) ---
logs/*
!logs/.gitkeep
data/
*.db
*.sqlite3
chroma/

# --- Модели (тяжёлые, качаются отдельно) ---
models/
*.gguf
*.safetensors
*.bin

# --- Артефакты сборок ---
artifacts/*.zip
artifacts/*.whl

# --- Unity (unity-client/, этап 6) ---
# подробнее — unity-client/.gitignore
unity-client/Library/
unity-client/Temp/
unity-client/Obj/
unity-client/Build/
unity-client/Builds/
unity-client/Logs/
unity-client/UserSettings/
unity-client/*.csproj
unity-client/*.sln
*.unitypackage
# тела персон лежат вне репозитория (D5.4), кроме процедурного тест-куба
*.vrm
!tests/samples/test_cube.vrm

# --- ОС / редакторы ---
Thumbs.db
Desktop.ini
.DS_Store
